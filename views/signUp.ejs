<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign Up</title>
</head>
<body>
<form action="/sign-up" method="post">
    <label for="firstName">First name:</label>
    <input type="text" name="firstName" value="<%= firstName %>" id="firstName">
    <label for="lastName">Last name:</label>
    <input type="text" name="lastName" value="<%= lastName %>" id="lastName">
    <label for="username">Username:</label>
    <input type="text" id="username" value="<%= username %>" name="username">
    <label for="password">Password:</label>
    <input type="password" name="password" value="<%= password %>" id="password">
    <label for="confirmPassword">Confirm password: </label>
    <input type="password" name="confirmPassword" value="<%= confirmPassword %>" id="confirmPassword">
    <%- include('components/errors.ejs', {errors: errors}) %>
    <button type="submit">Submit</button>
</form>
</body>
</html>
