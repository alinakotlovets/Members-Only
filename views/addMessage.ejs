<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/style.css">
    <title>Add messages</title>
</head>
<body>
<%- include("components/navbar.ejs") %>
<div class="container">
    <% if (user) { %>
        <form action="/message/add" method="post">
            <label for="title">Title:</label>
            <input type="text" id="title" value="<%= title %>" name="title">
            <label for="message">Message:</label>
            <input type="text" name="message" value="<%= message %>" id="message">
            <%- include('components/errors.ejs', {errors: errors}) %>
            <button type="submit">Submit</button>
        </form>
    <% } %>
</div>
</body>
</html>
