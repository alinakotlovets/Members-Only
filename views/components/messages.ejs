<% if(messages.length > 0 ){ %>
    <ul class="messages-list">
        <% messages.forEach((message)=>{ %>
            <li class="message-list-item">
                <h2><%= message.message_title %></h2>
                <h3 class="message-text"><%= message.message_text %></h3>
                <div class="message-list-item-text">
                    <h4 class="text-grey">Added by:</h4>
                    <h4 class="text-grey"><%= (user && user.is_member) ? message.username : "anonymous user" %></h4>
                </div>
                <% if (user && user.is_member) { %>
                    <div class="message-list-item-text">
                        <p class="text-grey">Added at:</p>
                        <p class="text-grey"><%= message.formattedDate %></p>
                    </div>
                <% } %>
                <% if(user && user.is_admin) { %>
                    <div class="btn-flex-end-box">
                        <button class="delete-message-btn red-btn" data-message-id="<%= message.message_id %>">Delete
                        </button>
                    </div>
                <% } %>
            </li>
        <% }) %>
    </ul>
<% } %>